# gluetun.env
VPN_SERVICE_PROVIDER: private internet access
VPN_TYPE: openvpn
# OpenVPN Settings:
OPENVPN_USER: /run/secrets/openvpn_user
OPENVPN_PASSWORD: /run/secrets/openvpn_password
PORT_FORWARD_ONLY: true
SERVER_REGIONS: CA Toronto
# Server-10xxx (x.x.x.x) PF API refused connections 2026-10-08; 12612/12613 (x.x.x.x) work
SERVER_NAMES: Server-12612-2a,Server-12613-2a
VPN_PORT_FORWARDING: on
UPDATER_PERIOD: 24h
UPDATER_MIN_RATIO: 0.5

# HTTP proxy for Shelfmark (media_network only, no host port)
HTTPPROXY: on
