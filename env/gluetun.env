# gluetun.env
VPN_SERVICE_PROVIDER: private internet access
VPN_TYPE: openvpn
# OpenVPN Settings:
OPENVPN_USER: /run/secrets/openvpn_user
OPENVPN_PASSWORD: /run/secrets/openvpn_password
PORT_FORWARD_ONLY: true
# No SERVER_NAMES pin: PIA renames servers and gluetun refuses to start if a pinned name
# leaves the list (outage 2026-10-14). PF tested 2026-10-14: Ontario 4/4, Montreal 8/8 OK.
SERVER_REGIONS: CA Ontario,CA Montreal
VPN_PORT_FORWARDING: on
UPDATER_PERIOD: 24h
UPDATER_MIN_RATIO: 0.5

# HTTP proxy for Shelfmark (media_network only, no host port)
HTTPPROXY: on
# Control server auth (port forwarder API key), built by init-secrets.sh from gluetun-apikey
HTTP_CONTROL_SERVER_AUTH_CONFIG_FILEPATH: /run/secrets/gluetun-auth-config
