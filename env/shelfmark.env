# shelfmark.env
# Settings set here are locked in the Shelfmark UI. Secrets (Hardcover key, AA donator key,
# OIDC client secret) are exported from /run/secrets by the command: wrapper in books-compose.yml.
SESSION_COOKIE_SECURE: true
SEARCH_MODE: universal
METADATA_PROVIDER: hardcover
HARDCOVER_ENABLED: true
DEFAULT_RELEASE_SOURCE: direct_download
DEFAULT_RELEASE_SOURCE_AUDIOBOOK: audiobookbay

# Login: OIDC via Authentik (authentik/blueprints/media-sso.yaml)
AUTH_METHOD: oidc
OIDC_ADMIN_GROUP: media-admins
OIDC_BUTTON_LABEL: Login with Plex

# Requests: users request the book only (no source lookups); admin picks the release when fulfilling
REQUESTS_ENABLED: true
REQUEST_POLICY_DEFAULT_EBOOK: request_book
REQUEST_POLICY_DEFAULT_AUDIOBOOK: request_book

# Sources
# Torrents (AudioBookBay, Prowlarr) go to qBittorrent; login from secrets via shelfmark/start.sh.
# qBittorrent saves to /data/torrents/<category>, the same path Shelfmark sees, so no path mapping.
PROWLARR_TORRENT_CLIENT: qbittorrent
QBITTORRENT_URL: http://gluetun:8088
QBITTORRENT_CATEGORY: books
QBITTORRENT_CATEGORY_AUDIOBOOK: audiobooks
# Like Sonarr/Radarr "Remove Completed": after import, remove the torrent and its files so
# /data/torrents only holds in-progress downloads (qBittorrent stops seeding at ratio 0 anyway)
PROWLARR_TORRENT_ACTION: remove_and_delete
DIRECT_DOWNLOAD_ENABLED: true
AA_MIRROR_URLS: https://annas-archive.gl,https://annas-archive.pk,https://annas-archive.gd
ABB_ENABLED: true
ABB_HOSTNAME: audiobookbay.lu

# Ebooks -> CWA ingest (CWA deletes after import, so no renaming/hardlinks)
DESTINATION: /data/cwa-ingest
FILE_ORGANIZATION: none
HARDLINK_TORRENTS: false
# Audiobooks -> Audiobookshelf library, hardlinked so torrents keep seeding
DESTINATION_AUDIOBOOK: /data/media/books
FILE_ORGANIZATION_AUDIOBOOK: organize
# One folder per book (Audiobookshelf layout); part number in file names keeps chapter order
TEMPLATE_AUDIOBOOK_ORGANIZE: {Author}/{Series/}{Title}/{Title}{ - Part }{PartNumber}
HARDLINK_TORRENTS_AUDIOBOOK: true

# Library links and "already owned" check
LIBRARY_CHECK_CALIBRE_ENABLED: true
CALIBRE_LIBRARY_DB_PATH: /data/media/ebooks/metadata.db

# Route external downloads (AA, libgen, bypasser, metadata) through gluetun's HTTP proxy.
# IRC is not proxied by Shelfmark; keep IRC sources disabled.
PROXY_MODE: http
HTTP_PROXY: http://gluetun:8888
