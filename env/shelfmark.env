# shelfmark.env
TZ: Etc/UTC
SEARCH_MODE: universal
SESSION_COOKIE_SECURE: true
# Login method (OIDC via Authentik) is set in the UI: Settings -> Security
# Ebooks -> CWA ingest (CWA deletes after import, so no renaming/hardlinks)
INGEST_DIR: /data/cwa-ingest
FILE_ORGANIZATION: none
HARDLINK_TORRENTS: false
# Audiobooks -> Audiobookshelf library, hardlinked so torrents keep seeding
DESTINATION_AUDIOBOOK: /data/media/books
FILE_ORGANIZATION_AUDIOBOOK: organize
HARDLINK_TORRENTS_AUDIOBOOK: true
# Route external downloads (AA, libgen, bypasser, metadata) through gluetun's HTTP proxy.
# IRC is not proxied by Shelfmark; keep IRC sources disabled.
PROXY_MODE: http
HTTP_PROXY: http://gluetun:8888
NO_PROXY: gluetun,calibre-web-automated,auth.example.com,localhost,127.0.0.1
